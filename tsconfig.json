{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "sourceMap": true,
    "outDir": "dist",
    "declaration": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": ["*.ts", "utils/*.ts", "__tests__/*.ts", "src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
} 